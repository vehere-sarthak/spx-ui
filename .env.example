# Copy to .env.local for lab. Production prefers /etc/spiderx/spiderx.yml
# (see DEPLOY.md). Env always overrides YAML.

# MySQL (ui_db) — also in spiderx.yml mySQL_config
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=vehere
MYSQL_PASSWORD=
MYSQL_DATABASE=ui_db

# Elasticsearch — also in spiderx.yml elasticsearch_config
ES_HOST=https://127.0.0.1:9200
ES_USERNAME=admin
ES_PASSWORD=
ES_REJECT_UNAUTHORIZED=false
ES_TRANSPORT=auto

# HTTPS (defaults match vehere-ui platform certs)
# SPIDERX_SSL_CERT=/usr/local/share/ca-certificates/VEHERE.crt
# SPIDERX_SSL_KEY=/usr/local/share/ca-certificates/VEHERE.key

# Auth / MFA
SPIDERX_SESSION_SECRET=change-me-in-production
APP_TOTP_ISSUER=SpiderX

# Companion API (optional rewrite target)
UISERVICE_URL=http://127.0.0.1:8083

NEXT_PUBLIC_APP_NAME=SpiderX
PORT=3010
