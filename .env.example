# spx-ui environment — PROCESS WIRING ONLY.
#
# Credentials and configuration do NOT belong here. They live in the YAML chain,
# mirroring vehere-ui (whose .env.development carries NEXT_PUBLIC_ENV alone):
#
#   1. config/spiderx.yml         committed, placeholders only
#   2. config/spiderx.dev.yml     dev box, git-ignored, real values  <- copy from spiderx.dev.yml.example
#   3. /etc/spiderx/spiderx.yml   appliance overlay, written by the installer
#   4. environment                the few keys below
#
# Selects the config profile. Must be "development" for spiderx.dev.yml to load.
NEXT_PUBLIC_ENV=development

# Override the listen port (otherwise server.port from the YAML chain).
# PORT=4000

# TLS material, if not at the appliance default paths.
# SPIDERX_SSL_CERT=/usr/local/share/ca-certificates/VEHERE.crt
# SPIDERX_SSL_KEY=/usr/local/share/ca-certificates/VEHERE.key

# Break-glass secret overrides. Prefer the YAML chain; these exist so an
# appliance can rotate without editing files on disk.
# SPIDERX_SESSION_SECRET=
# SPIDERX_AUTH_SECRET=

# Set on dev boxes behind a corporate proxy that must not intercept the appliance.
# NO_PROXY=*
# no_proxy=*
