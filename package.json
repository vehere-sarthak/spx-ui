{
  "name": "spx-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development NEXT_IGNORE_INCORRECT_LOCKFILE=1 node server.js",
    "dev:live": "bash scripts/dev-live.sh",
    "sync:es": "python3 scripts/sync-es-cache.py",
    "build": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 next build && node buildInfo.js",
    "start": "NODE_ENV=production node server.js",
    "setup:db": "bash setup_db.sh",
    "setup:es": "bash es_db_setup.sh",
    "lint": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 next lint",
    "dev:http": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 next dev -p 4000"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tanstack/react-table": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.460.0",
    "mysql2": "^3.24.3",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
